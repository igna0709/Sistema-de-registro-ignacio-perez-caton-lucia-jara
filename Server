
const express = require("express");
const mysql = require("mysql2");

const app = express();

app.use(express.json());
app.use(express.static("public"));

// Conexion con MySQL

const conexion = mysql.createConnection({
    host: "localhost",
    user: "root",
    password: "",
    database: "socios_db"
});

conexion.connect(function(error) {

    if (error) {
        console.log("Error de conexion");
    } else {
        console.log("Conectado a MySQL");
    }

});

// Guardar socio

app.post("/guardar", function(req, res) {

    let nombre = req.body.nombre;
    let apellido = req.body.apellido;
    let documento = Buffer.from(req.body.documento).toString("base64");
    let email = Buffer.from(req.body.email).toString("base64");
    let telefono = Buffer.from(req.body.telefono).toString("base64");

    let sql = "INSERT INTO socios (nombre, apellido, documento, email, telefono) VALUES (?, ?, ?, ?, ?)";

    conexion.query(sql, [nombre, apellido, documento, email, telefono], function(error) {

        if (error) {
            res.send("Error al guardar el socio");
        } else {
            res.send("Socio guardado correctamente");
        }

    });

});

// Iniciar servidor

app.listen(3000, function() {
    console.log("Servidor funcionando en puerto 3000");
});
